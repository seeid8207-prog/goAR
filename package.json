{
  "name": "goar",
  "version": "0.12.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test:navigation": "tsc -p tsconfig.navtest.json && node .navtest-build/lib/routeProgress.test.js",
    "api": "node server/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "field:android": "bash scripts/field-test-android.sh",
    "field:ios": "bash scripts/field-test-ios.sh",
    "release:check": "node scripts/validate-release.mjs",
    "eas-build-post-install": "node scripts/eas-post-install.mjs",
    "retention:cleanup": "node scripts/cleanup-retention.mjs",
    "test:server": "node server/security.test.mjs"
  },
  "dependencies": {
    "expo": "~57.0.17",
    "expo-camera": "*",
    "expo-location": "*",
    "expo-router": "*",
    "expo-sensors": "*",
    "expo-status-bar": "*",
    "@maplibre/maplibre-react-native": "^11.0.0",
    "@reactvision/react-viro": "^3.0.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "pg": "^8.13.1",
    "expo-constants": "~57.0.20",
    "expo-linking": "~57.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
