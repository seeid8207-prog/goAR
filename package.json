{
  "name": "goar",
  "version": "0.12.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test:navigation": "tsc -p tsconfig.navtest.json && node .navtest-build/lib/routeProgress.test.js",
    "api": "node server/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "field:android": "bash scripts/field-test-android.sh",
    "field:ios": "bash scripts/field-test-ios.sh"
  },
  "dependencies": {
    "expo": "~57.0.17",
    "expo-camera": "*",
    "expo-location": "*",
    "expo-router": "*",
    "expo-sensors": "*",
    "expo-status-bar": "*",
    "@maplibre/maplibre-react-native": "^11.0.0",
    "@reactvision/react-viro": "^3.0.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-screens": "^4.16.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "typescript": "^5.9.0"
  }
}
